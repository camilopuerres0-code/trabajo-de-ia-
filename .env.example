# Copia este archivo como .env.local y completa los valores (.env.local NO se sube a GitHub)
# Proveedor: gemini, openai o huggingface
PROVEEDOR=gemini
# Clave o token del proveedor (nunca con prefijo VITE_)
IA_API_KEY=
# Nombre exacto del modelo según la documentación vigente del proveedor
IA_MODELO=
